# ============================================================================
# HERE I AM — ENVIRONMENT CONFIGURATION
# ============================================================================
# Every setting in backend/app/config.py (the Settings class) can be overridden
# with an environment variable of the same name in UPPERCASE. This file lists
# them all. Values shown are the code defaults unless noted otherwise.
#
# Uncomment and edit a line to change it. Commented lines document the default
# and are safe to leave as-is. Only ANTHROPIC_API_KEY is strictly required.
# ============================================================================


# ============================================================================
# API KEYS
# ============================================================================
# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (optional, for OpenAI model support)
OPENAI_API_KEY=your_openai_api_key_here

# Google API Key (optional, for Gemini model support)
# GOOGLE_API_KEY=your_google_api_key_here

# MiniMax API Key (optional, for MiniMax model support via Anthropic-compatible API)
# MINIMAX_API_KEY=your_minimax_api_key_here

# Pinecone API Key (optional, required to enable the memory system)
# Memory features no-op without both PINECONE_API_KEY and PINECONE_INDEXES.
# PINECONE_API_KEY=your_pinecone_api_key_here

# Brave Search API key (optional, for the web_search tool)
# Get your API key at: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Mistral API key (optional, required only if the codebase navigator is enabled)
# Get your API key at: https://console.mistral.ai/
# MISTRAL_API_KEY=your_mistral_api_key_here

# Moltbook API key (optional, Bearer token; required only if Moltbook is enabled)
# MOLTBOOK_API_KEY=your_moltbook_api_key_here

# ElevenLabs API Key (optional, cloud-based TTS)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here


# ============================================================================
# APPLICATION
# ============================================================================
# Enable debug mode / hot reload
# DEBUG=true

# Database URL (SQLite for development)
HERE_I_AM_DATABASE_URL=sqlite+aiosqlite:///./here_i_am.db
# Optional: PostgreSQL for production
# HERE_I_AM_DATABASE_URL=postgresql+asyncpg://user:password@localhost/here_i_am


# ============================================================================
# ENTITIES / PINECONE MEMORY
# ============================================================================
# Each index represents a different AI entity with separate memory/history.
# Without this (and PINECONE_API_KEY) the memory system is disabled.
# Format: JSON array of objects with:
#   - index_name:    Pinecone index name
#   - label:         Display name for the entity
#   - description:   Optional description
#   - llm_provider:  "anthropic", "openai", "google", or "minimax" (default: "anthropic")
#   - default_model: Model for this entity (optional, uses provider default if unset)
#   - host:          URL of your Pinecone index's host server (required for serverless)
# PINECONE_INDEXES='[
#     {"index_name": "claude-main", "label": "Claude", "llm_provider": "anthropic", "host": "[Your Pinecone index host url]", "default_model": "claude-sonnet-4-5-20250929"},
#     {"index_name": "gpt-research", "label": "GPT", "llm_provider": "openai", "host": "[Your Pinecone index host url]", "default_model": "gpt-5.1"}
# ]'

# ============================================================================
# MEMORY RETRIEVAL & SIGNIFICANCE TUNING
# ============================================================================
# Number of memories retrieved on the first retrieval in a conversation
# (merged pool — applies only when MEMORY_ROLE_BALANCE_ENABLED is false)
# INITIAL_RETRIEVAL_TOP_K=5
# Number of memories retrieved on subsequent retrievals (merged pool, as above)
# RETRIEVAL_TOP_K=5
# Similarity floor for automatic retrieval from chat messages (llama-text-embed-v2)
# SIMILARITY_THRESHOLD=0.4
# Lower similarity floor for deliberate queries (memory_query tool, memory browser)
# QUERY_SIMILARITY_THRESHOLD=0.2
# Fetch this many times top_k candidates, then re-rank by significance
# RETRIEVAL_CANDIDATE_MULTIPLIER=2

# Significance calculation
# RECENCY_BOOST_STRENGTH=1.2
# SIGNIFICANCE_FLOOR=0.25
# Significance halves every N days since memory creation
# SIGNIFICANCE_HALF_LIFE_DAYS=60
# Significance bonus for memories created by `memory_save`
# REFLECTION_SIGNIFICANCE_MULTIPLIER=1.5

# Role balance retrieves the human's words and the entity's words as two
# separate candidate pools (both the current-message query and the entity's
# last-response query feed both pools) and takes the top N from each, so every
# retrieval carries an equal share of both. Set false to select from one
# merged pool purely by combined relevance score (cut at *_RETRIEVAL_TOP_K).
# MEMORY_ROLE_BALANCE_ENABLED=true
# Per-pool N with role balance on: first turn / subsequent turns
# INITIAL_RETRIEVAL_TOP_K_PER_ROLE=3
# RETRIEVAL_TOP_K_PER_ROLE=3

# Reflection mode
# REFLECTION_SEED_COUNT=7
# REFLECTION_EXCLUDE_RECENT_CONVERSATIONS=0


# ============================================================================
# MODEL DEFAULTS
# ============================================================================
# Default model per provider (overridable per entity via PINECONE_INDEXES).
# Model names are passed straight to provider APIs, so new models work as-is.
# DEFAULT_MODEL=claude-sonnet-4-5-20250929
# DEFAULT_OPENAI_MODEL=gpt-5.1
# DEFAULT_GOOGLE_MODEL=gemini-2.5-flash
# DEFAULT_MINIMAX_MODEL=MiniMax-M2.5

# Generation defaults
# DEFAULT_TEMPERATURE=1.0
# DEFAULT_MAX_TOKENS=64000
# Verbosity for GPT-5.1 models: low, medium, high
# DEFAULT_VERBOSITY=medium


# ============================================================================
# CONTEXT WINDOW LIMITS (tokens)
# ============================================================================
# Combined inbound token cap for conversation history (retrieved memories are
# part of the history). Leave headroom below the provider's real max;
# client-side token counting is approximate.
# CONTEXT_TOKEN_LIMIT=175000


# ============================================================================
# TOOL USE CONFIGURATION
# ============================================================================
# Enable AI tool use (web search, content fetching)
# TOOLS_ENABLED=true
# Maximum iterations for tool use before forcing a final response
# TOOL_USE_MAX_ITERATIONS=10
# (See BRAVE_SEARCH_API_KEY in the API KEYS section for web search.)


# ============================================================================
# GITHUB INTEGRATION CONFIGURATION
# ============================================================================
# Enable GitHub repository integration for AI entities
# GITHUB_TOOLS_ENABLED=true
#
# Configure repositories (JSON array). Each repository requires:
#   - owner: GitHub username or organization
#   - repo:  Repository name
#   - label: Display name for the repository
#   - token: GitHub Personal Access Token (classic or fine-grained)
# Optional fields:
#   - protected_branches:  Branches that cannot be committed to (default: ["main", "master"])
#   - capabilities:        Allowed operations (default: ["read", "branch", "commit", "pr", "issue"])
#   - local_clone_path:    Path to local clone for faster operations
#                          Supports Unix (/path/to/repo) and Windows (C:\path\to\repo) paths
#   - commit_author_name:  Name for commit attribution (defaults to PAT owner)
#   - commit_author_email: Email for commit attribution (defaults to PAT owner)
#
# Token permissions needed:
#   - Read-only:   Contents (read)
#   - Full access: Contents (read/write), Pull requests (read/write), Issues (read/write)
#
# GITHUB_REPOS='[
#     {
#         "owner": "your-username",
#         "repo": "your-repo",
#         "label": "My Project",
#         "token": "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
#         "protected_branches": ["main", "master", "production"],
#         "capabilities": ["read", "branch", "commit", "pr", "issue"],
#         "commit_author_name": "Your Name",
#         "commit_author_email": "your.email@example.com"
#     },
#     {
#         "owner": "your-org",
#         "repo": "another-repo",
#         "label": "Org Project (Read Only)",
#         "token": "ghp_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy",
#         "capabilities": ["read"]
#     }
# ]'


# ============================================================================
# ENTITY NOTES CONFIGURATION
# ============================================================================
# Enable persistent notes for AI entities
# NOTES_ENABLED=true
# Base directory for notes. Each entity gets {NOTES_BASE_DIR}/{entity_label}/;
# shared notes live in {NOTES_BASE_DIR}/shared/.
# NOTES_BASE_DIR=./notes


# ============================================================================
# ATTACHMENT CONFIGURATION
# ============================================================================
# Enable image/file attachments in conversations
# ATTACHMENTS_ENABLED=true
# Maximum attachment size in bytes (default: 5 MB)
# ATTACHMENT_MAX_SIZE_BYTES=5242880
# Allowed image MIME types (comma-separated)
# ATTACHMENT_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
# Allowed text file extensions for extraction (comma-separated)
# ATTACHMENT_ALLOWED_TEXT_EXTENSIONS=.txt,.md,.py,.js,.ts,.json,.yaml,.yml,.html,.css,.xml,.csv,.log
# Enable PDF text extraction (requires PyPDF2)
# ATTACHMENT_PDF_ENABLED=true
# Enable DOCX text extraction (requires python-docx)
# ATTACHMENT_DOCX_ENABLED=true


# ============================================================================
# MOLTBOOK CONFIGURATION (AI social network, optional)
# ============================================================================
# Enable Moltbook tools for AI entities
# MOLTBOOK_ENABLED=true
# API base URL (must use the www subdomain to preserve auth headers)
# MOLTBOOK_API_URL=https://www.moltbook.com/api/v1
# (See MOLTBOOK_API_KEY in the API KEYS section.)


# ============================================================================
# CODEBASE NAVIGATOR CONFIGURATION (optional)
# ============================================================================
# Cost-efficient codebase exploration using the Mistral Devstral model. Lets
# AI entities analyze large codebases before implementing changes.
#
# CODEBASE_NAVIGATOR_ENABLED=true
# (Requires MISTRAL_API_KEY — see the API KEYS section.)
#
# Model: devstral-small-latest, devstral-medium-latest, or devstral-2512
# CODEBASE_NAVIGATOR_MODEL=devstral-small-latest
# API timeout in seconds
# CODEBASE_NAVIGATOR_TIMEOUT=120
# Maximum retries for API calls
# CODEBASE_NAVIGATOR_MAX_RETRIES=3
# Maximum tokens per codebase chunk (leave headroom in Devstral's 256k context)
# CODEBASE_NAVIGATOR_MAX_TOKENS_PER_CHUNK=200000
# Maximum files to return in a single response
# CODEBASE_NAVIGATOR_MAX_RESULTS=50
# Response caching
# CODEBASE_NAVIGATOR_CACHE_ENABLED=true
# CODEBASE_NAVIGATOR_CACHE_DIR=.navigator_cache
# CODEBASE_NAVIGATOR_CACHE_TTL_HOURS=24
# File patterns (JSON arrays) — which files to include / exclude
# CODEBASE_NAVIGATOR_DEFAULT_INCLUDES='["*.py","*.js","*.ts","*.jsx","*.tsx","*.java","*.go","*.rs","*.c","*.cpp","*.h","*.json","*.yaml","*.yml","*.toml","*.md","*.sql","*.graphql","*.html","*.css","*.scss"]'
# CODEBASE_NAVIGATOR_DEFAULT_EXCLUDES='["node_modules/","venv/",".venv/","__pycache__/",".git/","dist/","build/",".next/","*.min.js","*.map","*.lock","*.bundle.js"]'


# ============================================================================
# TEXT-TO-SPEECH CONFIGURATION
# ============================================================================
# Choose ONE of the following TTS options:
#   1. ElevenLabs (cloud-based) - Set ELEVENLABS_API_KEY
#   2. XTTS v2 (local)          - Set XTTS_ENABLED=true
#   3. StyleTTS 2 (local)       - Set STYLETTS2_ENABLED=true
# Priority order: StyleTTS 2 > XTTS > ElevenLabs

# --- ElevenLabs (cloud) ---
# (See ELEVENLABS_API_KEY in the API KEYS section.)
# Custom voice ID (default: Rachel - 21m00Tcm4TlvDq8ikWAM)
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Custom model ID (default: eleven_multilingual_v2)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Multiple voices (JSON array) — adds a voice selector dropdown in settings.
# Format: [{"voice_id": "...", "label": "Name", "description": "Optional description"}]
# ELEVENLABS_VOICES='[
#     {"voice_id": "21m00Tcm4TlvDq8ikWAM", "label": "Rachel", "description": "Calm female"},
#     {"voice_id": "ErXwobaYiN019PkySvjV", "label": "Antoni", "description": "Warm male"}]'

# --- XTTS v2 (local, voice cloning) ---
# Requires the XTTS server to be running. Start it with:
#   1. Install PyTorch (GPU): pip install torch torchaudio --index-url https://download.pytorch.org/whl/cu118
#      Or CPU only:           pip install torch torchaudio --index-url https://download.pytorch.org/whl/cpu
#   2. pip install -r requirements-xtts.txt
#   3. python run_xtts.py
# XTTS_ENABLED=true
# XTTS_API_URL=http://localhost:8020
# XTTS_LANGUAGE=en
# XTTS_VOICES_DIR=./xtts_voices
# Default speaker sample file path (if not using cloned voices)
# XTTS_DEFAULT_SPEAKER=/path/to/speaker.wav
# Pre-load speaker latents on startup (comma-separated paths; read by the XTTS server process)
# XTTS_PRELOAD_SPEAKERS=/path/to/speaker1.wav,/path/to/speaker2.wav

# --- StyleTTS 2 (local, voice cloning) ---
# Takes priority over XTTS and ElevenLabs if enabled. Requires the StyleTTS 2
# server to be running. Start it with:
#   1. Install PyTorch (GPU): pip install torch torchaudio --index-url https://download.pytorch.org/whl/cu118
#      Or CPU only:           pip install torch torchaudio --index-url https://download.pytorch.org/whl/cpu
#   2. pip install -r requirements-styletts2.txt
#   3. python run_styletts2.py
# STYLETTS2_ENABLED=true
# STYLETTS2_API_URL=http://localhost:8021
# STYLETTS2_VOICES_DIR=./styletts2_voices
# Default speaker sample file path (if not using cloned voices)
# STYLETTS2_DEFAULT_SPEAKER=/path/to/speaker.wav
# Phonemizer backend: "gruut" (default, MIT licensed, no system deps) or "espeak"
# (espeak requires espeak-ng installed on your system)
# STYLETTS2_PHONEMIZER=gruut
# Pre-load speaker embeddings on startup (comma-separated paths; read by the StyleTTS 2 server process)
# STYLETTS2_PRELOAD_SPEAKERS=/path/to/speaker1.wav,/path/to/speaker2.wav
# Pronunciation fixes: JSON object mapping mispronounced words to phonetic spellings.
# Default fixes are used if unset; set to {} to disable all fixes. (Read by the StyleTTS 2 server process.)
# STYLETTS2_PRONUNCIATION_FIXES='{"turned": "turnd", "learned": "lernd", "burned": "burnd", "earned": "ernd", "into": "in to"}'


# ============================================================================
# SPEECH-TO-TEXT CONFIGURATION (Whisper, optional)
# ============================================================================
# Local Whisper STT with punctuation (replaces browser dictation). Requires the
# Whisper server to be running. Start it with:
#   1. Install PyTorch (GPU): pip install torch torchaudio --index-url https://download.pytorch.org/whl/cu118
#      Or CPU only:           pip install torch torchaudio --index-url https://download.pytorch.org/whl/cpu
#   2. pip install -r requirements-whisper.txt
#   3. python run_whisper.py
# WHISPER_ENABLED=true
# WHISPER_API_URL=http://localhost:8030
# Model: tiny, base, small, medium, large-v2, large-v3, distil-large-v3
# WHISPER_MODEL=large-v3
# Dictation mode used by the frontend:
#   - "whisper": always use local Whisper (fails if the server is unavailable)
#   - "browser": always use the browser's Web Speech API (no punctuation)
#   - "auto":    use Whisper if available, fall back to browser (default)
# DICTATION_MODE=auto
